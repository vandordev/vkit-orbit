# syntax=docker/dockerfile:1.11
FROM oven/bun:1.4.2-alpine AS base
WORKDIR /app
FROM base AS prune
COPY . .
RUN bunx turbo@2.10.4 prune @repo/migrate --docker
FROM base AS deps
COPY --from=prune /app/out/json/ ./
RUN bun install --ignore-scripts
FROM base AS runner
COPY --from=deps /app/node_modules ./node_modules
COPY --from=prune /app/out/full/ ./
COPY config /app/config
CMD ["bun", "--no-env-file", "run", "packages/config/src/run.ts", "--runtime", "migrate", "--root", "/app", "--", "bun", "apps/migrate/src/main.ts"]
