{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"@repo/storybook#build": {
			"cache": false,
			"outputs": ["storybook-static/**"]
		},
		"build": {
			"dependsOn": [
				"^build"
			],
			"outputs": [
				".output/**",
				".vite/**",
				"dist/**"
			],
		},
		"lint": {
			"dependsOn": [
				"^lint"
			],
			"outputs": []
		},
		"check-types": {
			"dependsOn": [
				"^check-types"
			],
			"outputs": []
		},
		"dev": {
			"passThroughEnv": ["NODE_ENV", "LOG_LEVEL", "DATABASE_URL", "WEB_*", "API_*", "CORS_ORIGIN", "OPENAPI_*", "REDIS_*", "S3_*", "REALTIME_*", "WORKER_NOTIFICATION_*", "WEBHOOK_SECRET_ENCRYPTION_KEY"],
			"cache": false,
			"persistent": true
		},
		"clean": {
			"cache": false
		}
	}
}
