# Required local database connection.
DATABASE_URL=postgresql://user:password@localhost:5432/boilerplate

# Optional runtime overrides.
NODE_ENV=development
LOG_LEVEL=debug
WEB_HOST=0.0.0.0
WEB_PORT=4100
WEB_ORIGIN=http://localhost:4100
API_HOST=0.0.0.0
API_PORT=4101
CORS_ORIGIN=http://localhost:4100
OPENAPI_SERVER_URL=http://localhost:4101
REALTIME_URL=http://localhost:4102
REALTIME_CORS_ORIGIN=http://localhost:4100
WORKER_NOTIFICATION_URL=http://localhost:4101/internal/worker-events
WORKER_NOTIFICATION_API_KEY=replace-with-a-local-secret
REALTIME_INTERNAL_URL=http://localhost:4102
REALTIME_PUBLISH_API_KEY=replace-with-a-local-secret
REALTIME_HOST=0.0.0.0
REALTIME_PORT=4102

# Optional OpenAPI protection.
OPENAPI_BASIC_AUTH_USERNAME=
OPENAPI_BASIC_AUTH_PASSWORD=

# Required by web tickets and realtime verification.
REALTIME_TICKET_SECRET=replace-with-a-local-secret

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=dph:
REDIS_CONNECT_TIMEOUT_MS=5000

# Optional private S3/MinIO object storage.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_ROOT_PREFIX=uploads

# Required for webhook creation/signing: generate 32 random bytes as hex.
# Share the same key across web, API and worker. Never commit the real value.
WEBHOOK_SECRET_ENCRYPTION_KEY=
