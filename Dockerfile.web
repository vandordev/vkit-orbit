# syntax=docker/dockerfile:1.11
FROM oven/bun:1.4.2-alpine AS base
WORKDIR /app
FROM base AS prune
COPY . .
RUN bunx turbo@2.10.4 prune web --docker
FROM base AS deps
COPY --from=prune /app/out/json/ ./
RUN bun install --ignore-scripts
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=prune /app/out/full/ ./
COPY config ./config
ENV NODE_ENV=production
RUN DATABASE_URL=postgresql://tooling:tooling@localhost:5432/tooling bun --no-env-file run --cwd packages/db db:generate
RUN cd apps/web && bun run build
FROM base AS runtime-deps
COPY --from=prune /app/out/json/ ./
RUN bun install --production --ignore-scripts
FROM oven/bun:1.4.2-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S app && adduser -S app -G app
COPY --from=runtime-deps --chown=app:app /app/node_modules ./node_modules
COPY --from=builder --chown=app:app /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder --chown=app:app /app/apps/web/.output ./.output
COPY --from=builder --chown=app:app /app/packages/config ./packages/config
COPY --from=builder --chown=app:app /app/config ./config
COPY --from=builder --chown=app:app /app/package.json ./package.json
USER app
EXPOSE 4100
CMD ["bun", "--no-env-file", "run", "packages/config/src/run.ts", "--runtime", "web", "--root", "/app", "--", "bun", ".output/server/index.mjs"]
