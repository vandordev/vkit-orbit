{
	"extends": "@repo/typescript-config/base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["vite/client", "bun"]
	},
	"include": [".storybook/**/*.ts", "test/**/*.ts"],
	"exclude": ["node_modules", "storybook-static"]
}
